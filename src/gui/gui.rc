// HNx Packer resources: the manifest, plus the stub payload added by CMake.
#include <windows.h>
#include "hnx_version.h"

1 RT_MANIFEST "gui.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     HNX_VERSION_RC
    PRODUCTVERSION  HNX_VERSION_RC
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HNx"
            VALUE "FileDescription",  "HNx Packer"
            VALUE "FileVersion",      HNX_VERSION_RC_STRING
            VALUE "InternalName",     "HNxPacker"
            VALUE "OriginalFilename", "HNxPacker.exe"
            VALUE "ProductName",      "HNx"
            VALUE "ProductVersion",   HNX_VERSION_RC_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
